# Environment
PYVOLLEY_ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///data/pyvolley.db

# FFVB Scraping
FFVB_BASE_URL=https://www.ffvbbeach.org/ffvbapp/resu/
FFVB_REQUEST_DELAY=0.4

# Web Server
WEB_HOST=127.0.0.1
WEB_PORT=8000
SECRET_KEY=dev-secret-key-change-in-production

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pyvolley.log
